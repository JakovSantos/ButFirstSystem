{{! Login (C# Form1): same validation and messages; accounts come from the users table. }}
<div class="login">
    <aside class="login-art" style="background-image:url('/assets/img/login-bg.webp')">
        <div class="login-art-inner">
            <a class="brand" href="/login">
                <img src="/assets/img/logo-mark.png" alt="">
                <span class="brand-name"><strong>BUT FIRST</strong><span>System</span></span>
            </a>
            <div>
                <blockquote>Inventory, schedules and payroll — <span>but first, coffee.</span></blockquote>
                <small>But First Coffee Floridablanca · JAMM Bldg, Brgy Solib, Pampanga</small>
            </div>
        </div>
    </aside>

    <main class="login-panel">
        <form id="login-form" class="login-card" method="post" action="/login" autocomplete="off" novalidate>
            <input type="hidden" name="_token" value="{{csrfToken}}">
            <p class="eyebrow">Staff portal</p>
            <h1>Welcome back</h1>
            <p class="sub">Sign in to manage the shop's stock, shifts and payroll.</p>

            <div class="field">
                <label for="txtUser">User / Employee ID</label>
                <input class="input" id="txtUser" name="username" value="{{username}}" autocomplete="username" placeholder="admin or F-001" autofocus>
            </div>
            <div class="field">
                <label for="txtPassword">Password</label>
                <div class="pw-wrap">
                    <input class="input" id="txtPassword" name="password" type="password" autocomplete="current-password" placeholder="••••••••">
                    <button type="button" class="icon-btn" id="btnTogglePw" aria-label="Show password">
                        <svg class="ico" viewBox="0 0 24 24"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
                    </button>
                </div>
            </div>

            <div class="login-actions">
                <button type="submit" class="btn btn-primary" id="btnLogin">Sign in</button>
                <button type="button" class="btn btn-outline" id="btnExit">Exit</button>
            </div>
            <p class="login-hint">Employees sign in with their Employee ID and see only their own payroll.</p>
        </form>
    </main>
</div>

<div class="closed-note" id="closed-note" hidden>
    <div>
        <p>But First System has been closed.</p>
        <a href="/login" class="btn btn-accent">Open again</a>
    </div>
</div>
