<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>{{title}}</title>
    <link rel="icon" href="/favicon.ico">
    <style>
        /* Replica of the C# PrintDocument output (Arial, landscape where the C# code sets Landscape = true). */
        @page { size: {{#portrait}}portrait{{/portrait}}{{^portrait}}landscape{{/portrait}}; margin: 1in; }
        * { box-sizing: border-box; }
        body { margin: 0; background: #808080; font-family: Arial, Helvetica, sans-serif; color: #000; }
        .toolbar { position: sticky; top: 0; background: #F0F0F0; border-bottom: 1px solid #C8C8C8; padding: 6px 10px; display: flex; gap: 8px; font: 9pt "Segoe UI", Tahoma, sans-serif; align-items: center; }
        .toolbar button { min-width: 75px; height: 23px; background: #E1E1E1; border: 1px solid #ADADAD; font: inherit; }
        .toolbar button:hover { background: #E5F1FB; border-color: #0078D7; }
        .sheet { background: #fff; margin: 16px auto; padding: 0.6in; width: 11in; min-height: 8.5in; box-shadow: 0 2px 10px rgba(0,0,0,.4); display: flex; flex-direction: column; }
        .sheet.portrait { width: 8.5in; min-height: 11in; }
        .center { text-align: center; }
        .company { font-size: 16pt; font-weight: bold; }
        .address { font-size: 9pt; margin-top: 4px; }
        .rule { border: 0; border-top: 1px solid #000; margin: 14px 0 10px; }
        .title { font-size: 18pt; font-weight: bold; margin: 4px 0 8px; }
        .period { font-size: 10pt; font-style: italic; }
        .muted { color: #808080; }
        table { width: 100%; border-collapse: collapse; margin-top: 14px; }
        th { text-align: left; font-size: 10pt; height: 30px; padding: 0 5px; }
        td { font-size: 9pt; height: 28px; padding: 0 5px; vertical-align: middle; }
        .footer { margin-top: auto; padding-top: 20px; font-size: 9pt; font-style: italic; }
        .holidays { font-size: 9pt; margin-top: 10px; }
        @media print {
            body { background: #fff; }
            .toolbar { display: none; }
            .sheet { margin: 0; padding: 0; box-shadow: none; width: auto; min-height: 0; height: auto; }
        }
    </style>
</head>
<body>
<div class="toolbar">
    <button type="button" onclick="window.print()">Print…</button>
    <button type="button" onclick="window.close()">Close</button>
    <span>Print Preview - {{title}}</span>
</div>
{{{content}}}
<script>
    // C# shows a PrintDialog first; the browser print dialog is the equivalent.
    window.addEventListener('load', function () { setTimeout(function () { window.print(); }, 300); });
</script>
</body>
</html>
