<div class="titlebar">
    <img class="titlebar-icon" src="/favicon.ico" alt="">
    <span class="titlebar-text">{{title}}</span>
    <div class="titlebar-buttons">
        <button type="button" class="tb-btn" data-window="minimize" aria-label="Minimize"><svg width="10" height="10" viewBox="0 0 10 10"><path d="M0 5h10" stroke="currentColor"/></svg></button>
        <button type="button" class="tb-btn" data-window="maximize" aria-label="Maximize"><svg width="10" height="10" viewBox="0 0 10 10"><rect x=".5" y=".5" width="9" height="9" fill="none" stroke="currentColor"/></svg></button>
        <button type="button" class="tb-btn tb-close" data-window="close" aria-label="Close"><svg width="10" height="10" viewBox="0 0 10 10"><path d="M0 0l10 10M10 0L0 10" stroke="currentColor"/></svg></button>
    </div>
</div>
