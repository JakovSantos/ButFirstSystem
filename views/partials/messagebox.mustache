<!-- Confirmation / alert dialog. Driven by MsgBox in app.js. -->
<div id="msgbox-overlay" class="dialog-overlay" hidden>
    <div class="dialog" role="alertdialog" aria-modal="true" aria-labelledby="msgbox-caption" aria-describedby="msgbox-text">
        <div id="msgbox-icon" class="dialog-icon"></div>
        <h3 id="msgbox-caption">Message</h3>
        <p id="msgbox-text"></p>
        <div class="dialog-buttons" id="msgbox-buttons"></div>
    </div>
</div>
