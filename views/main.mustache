{{!
    Main window (C# Form2). All three modules are rendered on every request and the
    sidebar switches between them, like the original TabControl. Element ids match
    the C# control names so public/assets/js/app.js can port the event handlers 1:1.
}}
<div class="app" id="main-window" data-role="{{user.role}}">

    <!-- ============================== Sidebar ============================== -->
    <aside class="sidebar">
        <a class="brand" href="/inventory">
            <img src="/assets/img/logo.png" alt="">
            <span class="brand-name"><strong>BUT FIRST</strong><span>System</span></span>
        </a>
        <nav class="nav" aria-label="Modules">
            <div class="nav-label">Manage</div>
            <a href="/inventory" class="nav-item{{#tabInventory}} active{{/tabInventory}}" data-tab="inventory">
                <svg class="ico" viewBox="0 0 24 24"><path d="M21 8l-9-5-9 5 9 5 9-5z"/><path d="M3 8v8l9 5 9-5V8M12 13v8"/></svg>Inventory</a>
            <a href="/schedule" class="nav-item{{#tabSchedule}} active{{/tabSchedule}}" data-tab="schedule">
                <svg class="ico" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>Employee schedule</a>
            <a href="/payroll" class="nav-item{{#tabPayroll}} active{{/tabPayroll}}" data-tab="payroll">
                <svg class="ico" viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="14" rx="2"/><path d="M3 10h18M16 15h2"/></svg>Payroll</a>
        </nav>
        <div class="sidebar-foot">
            <a class="side-link" href="/docs" target="_blank" rel="noopener">API documentation ↗</a>
            <div class="user-chip">
                <span class="avatar">{{userInitial}}</span>
                <span class="who"><strong>{{user.username}}</strong><span>{{roleLabel}}</span></span>
                <button type="button" class="icon-btn js-logout" title="Sign out" aria-label="Sign out">
                    <svg class="ico" viewBox="0 0 24 24"><path d="M15 4h4a1 1 0 011 1v14a1 1 0 01-1 1h-4M10 16l4-4-4-4M14 12H4"/></svg>
                </button>
            </div>
        </div>
    </aside>

    <!-- Mobile header + nav -->
    <div class="mobile-shell">
        <div class="mobile-bar">
            <a class="brand" href="/inventory"><img src="/assets/img/logo.png" alt=""><span class="brand-name"><strong>BUT FIRST</strong><span>System</span></span></a>
            <button type="button" class="icon-btn js-logout" aria-label="Sign out"><svg class="ico" viewBox="0 0 24 24"><path d="M15 4h4a1 1 0 011 1v14a1 1 0 01-1 1h-4M10 16l4-4-4-4M14 12H4"/></svg></button>
        </div>
        <nav class="mobile-nav" aria-label="Modules">
            <a href="/inventory" class="nav-item{{#tabInventory}} active{{/tabInventory}}" data-tab="inventory">Inventory</a>
            <a href="/schedule" class="nav-item{{#tabSchedule}} active{{/tabSchedule}}" data-tab="schedule">Schedule</a>
            <a href="/payroll" class="nav-item{{#tabPayroll}} active{{/tabPayroll}}" data-tab="payroll">Payroll</a>
        </nav>

    <main class="main">

        <!-- =========================================================== -->
        <!-- INVENTORY                                                    -->
        <!-- =========================================================== -->
        <section data-tabpage="inventory" data-title="Inventory" {{^tabInventory}}hidden{{/tabInventory}}>
            <div class="page-head">
                <div>
                    <p class="eyebrow">Inventory</p>
                    <h1>Products &amp; stock</h1>
                    <p class="sub">Track what's on the shelf, what's running low and what it's all worth.</p>
                </div>
                <div class="head-actions">
                    <button type="button" class="btn btn-outline" id="btnLoad">
                        <svg class="ico" viewBox="0 0 24 24"><path d="M20 11a8 8 0 10-2.3 5.7M20 4v7h-7"/></svg>Reload</button>
                    <button type="button" class="btn btn-primary" id="btnPrintInventorySum">
                        <svg class="ico" viewBox="0 0 24 24"><path d="M7 9V3h10v6M7 17H5a2 2 0 01-2-2v-4a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2h-2"/><rect x="7" y="14" width="10" height="7"/></svg>Print summary</button>
                </div>
            </div>

            <div class="stats">
                <div class="stat dark">
                    <div class="stat-label">Total value</div>
                    <div class="stat-value" id="lbTotal">{{inventory.summary.total}}</div>
                    <div class="stat-note">{{inventory.summary.units}} units on hand</div>
                </div>
                <div class="stat">
                    <div class="stat-label">Products</div>
                    <div class="stat-value">{{inventory.count}}</div>
                    <div class="stat-note">{{#inventory.search}}matching “{{inventory.search}}”{{/inventory.search}}{{^inventory.search}}in the catalogue{{/inventory.search}}</div>
                </div>
                <div class="stat">
                    <div class="stat-label">Most stocked</div>
                    <div class="stat-value" id="lbMostStocked" title="{{inventory.summary.most}}">{{inventory.summary.most}}</div>
                    <div class="stat-note">{{inventory.summary.mostQty}}</div>
                </div>
                <div class="stat">
                    <div class="stat-label">Lowest stocked</div>
                    <div class="stat-value" id="lbLeastStocked" title="{{inventory.summary.least}}">{{inventory.summary.least}}</div>
                    <div class="stat-note">{{inventory.summary.leastQty}}</div>
                </div>
            </div>

            <div class="layout">
                <!-- Product information -->
                <form id="product-form" class="card" method="post" action="/inventory" enctype="multipart/form-data" novalidate>
                    <input type="hidden" name="_token" value="{{csrfToken}}">
                    <input type="hidden" name="image_path" id="hidImagePath" value="">
                    <input type="file" name="image" id="fileImage" accept=".jpg,.jpeg,.png,.bmp,image/jpeg,image/png,image/bmp" hidden>

                    <div class="card-head">
                        <h2>Product information</h2>
                        <span class="badge new" id="invMode">New product</span>
                    </div>
                    <div class="card-body">
                        <div class="picker" id="pboxProductImage" role="button" tabindex="0" aria-label="Browse image">
                            <img alt="" hidden>
                            <div class="empty">
                                <svg class="ico" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="M21 16l-5-5-9 9"/></svg>
                                <strong>Browse image</strong><span>JPG, PNG or BMP · up to 5 MB</span>
                            </div>
                            <span class="change">Change image</span>
                        </div>
                        <button type="button" id="btnBrowse" class="sr-only">Browse image</button>
                        <input id="txtFilePath" class="sr-only" readonly tabindex="-1" aria-label="Image file path">
                        <div class="file-path" id="filePathLabel">No image selected</div>

                        <div class="fields" style="margin-top:16px;">
                            <div class="field full">
                                <label for="txtProductName">Product name</label>
                                <input class="input" id="txtProductName" name="product_name" placeholder="e.g. BFC Iced Coffee">
                            </div>
                            <div class="field">
                                <label for="cmbCategory">Category</label>
                                <select class="select" id="cmbCategory" name="category">
                                    <option value="">Select…</option>
                                    {{#inventory.categories}}<option value="{{value}}">{{value}}</option>{{/inventory.categories}}
                                </select>
                            </div>
                            <div class="field">
                                <label for="udQuantity">Quantity</label>
                                <div class="stepper">
                                    <button type="button" tabindex="-1" data-step="-1" aria-label="Decrease">−</button>
                                    <input id="udQuantity" name="quantity" value="0" inputmode="numeric" data-min="0" data-max="1000">
                                    <button type="button" tabindex="-1" data-step="1" aria-label="Increase">+</button>
                                </div>
                            </div>
                            <div class="field">
                                <label for="txtPrice">Price (₱)</label>
                                <input class="input" id="txtPrice" name="price" inputmode="decimal" placeholder="0.00">
                            </div>
                            <div class="field">
                                <label for="dtDateAdded">Date added</label>
                                <input class="input" type="date" id="dtDateAdded" name="date_added" value="{{today}}">
                            </div>
                            <div class="field">
                                <label for="txtSupplier">Supplier</label>
                                <input class="input" id="txtSupplier" name="supplier" placeholder="Supplier name">
                            </div>
                            <div class="field">
                                <label for="txtProductID">Product ID</label>
                                <input class="input" id="txtProductID" readonly tabindex="-1" placeholder="Auto">
                            </div>
                        </div>
                    </div>
                    <div class="card-foot">
                        <button type="submit" class="btn btn-primary" id="btnAdd" style="flex:1">Add</button>
                        <button type="button" class="btn btn-outline" id="btnUpdate" {{#isEmployee}}disabled title="Not available for employee accounts"{{/isEmployee}}>
                            <svg class="ico" viewBox="0 0 24 24"><path d="M4 20h4L19 9l-4-4L4 16v4z"/></svg>Edit</button>
                        <button type="button" class="btn btn-danger" id="btnRemove" {{#isEmployee}}disabled title="Not available for employee accounts"{{/isEmployee}}>
                            <svg class="ico" viewBox="0 0 24 24"><path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13"/></svg>Remove</button>
                        <button type="button" class="btn btn-ghost btn-sm" id="btnNewProduct" style="width:100%">Clear form · new product</button>
                    </div>
                </form>
                <form id="remove-form" method="post" action="" hidden>
                    <input type="hidden" name="_token" value="{{csrfToken}}">
                </form>

                <div class="stack">
                    <!-- Product list -->
                    <div class="card">
                        <div class="toolbar">
                            <form id="search-form" method="get" action="/inventory" class="search">
                                <svg class="ico" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
                                <input class="input" id="txtSearch" name="search" value="{{inventory.search}}" placeholder="Search by name, ID, category or supplier" autocomplete="off" aria-label="Search products">
                            </form>
                            <button type="button" class="btn btn-ghost" id="btnClear_Inv">Clear</button>
                        </div>
                        <div class="table-wrap dgv" id="inventoryGrid">
                            <table>
                                <thead>
                                    <tr><th>Product</th><th>Category</th><th class="num">Price</th><th class="num">Qty</th><th>Added</th></tr>
                                </thead>
                                <tbody>
                                    {{#inventory.rows}}
                                    <tr data-id="{{product_id}}" data-row="{{json}}">
                                        <td>
                                            <div class="product-cell">
                                                {{#image_url}}<img class="thumb" src="{{image_url}}" alt="" loading="lazy">{{/image_url}}
                                                {{^image_url}}<span class="thumb">{{initials}}</span>{{/image_url}}
                                                <div><div class="name">{{product_name}}</div><div class="meta">#{{product_id}} · {{supplier}}</div></div>
                                            </div>
                                        </td>
                                        <td><span class="badge">{{category}}</span></td>
                                        <td class="num strong">{{price_display}}</td>
                                        <td class="num">{{quantity}}{{#low}} <span class="badge low">Low</span>{{/low}}</td>
                                        <td class="muted" style="white-space:nowrap">{{date_display}}</td>
                                    </tr>
                                    {{/inventory.rows}}
                                    {{^inventory.rows}}
                                    <tr class="empty-row"><td colspan="5">No products found.</td></tr>
                                    {{/inventory.rows}}
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Chart -->
                    <div class="card">
                        <div class="card-head"><h2>Top 10 most stocked products</h2><span class="hint">Units on hand</span></div>
                        <div class="chart">{{{inventory.chart}}}</div>
                    </div>
                </div>
            </div>
        </section>

        <!-- =========================================================== -->
        <!-- EMPLOYEE SCHEDULE                                            -->
        <!-- =========================================================== -->
        <section data-tabpage="schedule" data-title="Employee schedule" {{^tabSchedule}}hidden{{/tabSchedule}}>
            <div class="page-head">
                <div>
                    <p class="eyebrow">Employee schedule</p>
                    <h1>Shift generator</h1>
                    <p class="sub">Plan who works when, hand out days off and shuffle the roster.</p>
                </div>
                <div class="head-actions">
                    <button type="button" class="btn btn-outline" id="btnPrintSched">
                        <svg class="ico" viewBox="0 0 24 24"><path d="M7 9V3h10v6M7 17H5a2 2 0 01-2-2v-4a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2h-2"/><rect x="7" y="14" width="10" height="7"/></svg>Print schedule</button>
                    <form id="reset-dayoff-form" method="post" action="/schedule/reset-dayoff">
                        <input type="hidden" name="_token" value="{{csrfToken}}">
                        <input type="hidden" name="sched_start" class="js-sched-start">
                        <input type="hidden" name="sched_end" class="js-sched-end">
                        <button type="button" class="btn btn-outline" id="btnResetDayoff">Reset days off</button>
                    </form>
                    <form id="randomize-form" method="post" action="/schedule/randomize">
                        <input type="hidden" name="_token" value="{{csrfToken}}">
                        <input type="hidden" name="sched_start" class="js-sched-start">
                        <input type="hidden" name="sched_end" class="js-sched-end">
                        <button type="submit" class="btn btn-primary" id="btnRandomize">
                            <svg class="ico" viewBox="0 0 24 24"><path d="M3 7h3c4 0 6 10 10 10h5M3 17h3c1.5 0 2.7-1.4 3.8-3M14 7h7M18 4l3 3-3 3M18 14l3 3-3 3"/></svg>Randomize shifts</button>
                    </form>
                </div>
            </div>

            <div class="layout">
                <div class="stack">
                    <div class="card">
                        <div class="card-head"><h2>Schedule period</h2></div>
                        <div class="card-body fields">
                            <div class="field"><label for="dtStartDate">Start date</label><input class="input" type="date" id="dtStartDate" value="{{schedule.start}}"></div>
                            <div class="field"><label for="dtEndDate">End date</label><input class="input" type="date" id="dtEndDate" value="{{schedule.end}}"></div>
                        </div>
                    </div>

                    <form id="dayoff-form" class="card" method="post" action="/schedule/dayoff">
                        <input type="hidden" name="_token" value="{{csrfToken}}">
                        <input type="hidden" name="names" id="hidDayoffName">
                        <input type="hidden" name="sched_start" class="js-sched-start">
                        <input type="hidden" name="sched_end" class="js-sched-end">
                        <div class="card-head"><h2>Employee details</h2><span class="hint">Select a row</span></div>
                        <div class="card-body">
                            <div class="fields">
                                <div class="field full"><label for="txtEmployee">Name</label><input class="input" id="txtEmployee" readonly placeholder="—"></div>
                                <div class="field"><label for="txtSchedule">Schedule</label><input class="input" id="txtSchedule" readonly placeholder="—"></div>
                                <div class="field"><label for="txtBreak">Break</label><input class="input" id="txtBreak" readonly placeholder="—"></div>
                                <div class="field full"><label for="txtDuties">Duties</label><textarea class="textarea" id="txtDuties" readonly rows="2" placeholder="—"></textarea></div>
                            </div>
                            <div class="section-title" style="margin-top:20px;">Request a day off</div>
                            <div style="display:flex;gap:10px;">
                                <select class="select" id="cmbDayoff" name="day_off" aria-label="Day off">
                                    <option value="">Select a day…</option>
                                    {{#schedule.days}}<option value="{{value}}">{{value}}</option>{{/schedule.days}}
                                </select>
                                <button type="submit" class="btn btn-accent" id="btnRequest">Request</button>
                            </div>
                        </div>
                    </form>
                </div>

                <div class="stack">
                    <div class="card">
                        <div class="card-head"><h2>Days off this week</h2><span class="hint">One employee per day</span></div>
                        <div class="week">
                            {{#schedule.board}}
                            <div class="day {{#taken}}taken{{/taken}}{{^taken}}free{{/taken}}">
                                <div class="dname">{{day}}</div>
                                <div class="who">{{#taken}}{{names}}{{/taken}}{{^taken}}Available{{/taken}}</div>
                            </div>
                            {{/schedule.board}}
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-head"><h2>Shift roster</h2><span class="hint">{{schedule.count}} employees</span></div>
                        <div class="table-wrap short dgv" id="shiftGrid">
                            <table>
                                <thead><tr><th>Employee</th><th>Schedule</th><th>Break</th><th>Duties</th><th>Day off</th></tr></thead>
                                <tbody>
                                    {{#schedule.rows}}
                                    <tr data-id="{{id}}" data-row="{{json}}">
                                        <td><div class="person"><span class="avatar">{{initials}}</span><span class="strong">{{names}}</span></div></td>
                                        <td style="white-space:nowrap">{{schedule}}</td>
                                        <td class="muted" style="white-space:nowrap">{{breaks}}</td>
                                        <td>{{duties}}</td>
                                        <td>{{#day_off}}<span class="badge accent">{{day_off}}</span>{{/day_off}}{{^day_off}}<span class="muted">—</span>{{/day_off}}</td>
                                    </tr>
                                    {{/schedule.rows}}
                                    {{^schedule.rows}}
                                    <tr class="empty-row"><td colspan="5">No shifts yet.</td></tr>
                                    {{/schedule.rows}}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- =========================================================== -->
        <!-- PAYROLL                                                      -->
        <!-- =========================================================== -->
        <section data-tabpage="payroll" data-title="Payroll" {{^tabPayroll}}hidden{{/tabPayroll}}>
            <div class="page-head">
                <div>
                    <p class="eyebrow">Payroll</p>
                    <h1>Payroll management</h1>
                    <p class="sub">₱550 daily rate · overtime at 1.25× · SSS, PhilHealth, Pag-IBIG and late deductions.</p>
                </div>
                <div class="head-actions">
                    <button type="button" class="btn btn-primary" id="btnPrintPayroll">
                        <svg class="ico" viewBox="0 0 24 24"><path d="M7 9V3h10v6M7 17H5a2 2 0 01-2-2v-4a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2h-2"/><rect x="7" y="14" width="10" height="7"/></svg>Print payroll</button>
                </div>
            </div>

            <div class="banner" id="holidayBanner">
                <svg class="ico" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4M12 14l1 2h2l-1.6 1.3.6 2.2-2-1.3-2 1.3.6-2.2L9 16h2z"/></svg>
                <div id="statusHolidays"><strong>Checking Philippine holidays for this payroll period…</strong></div>
            </div>

            <div class="pay-hero" style="margin-bottom:20px;">
                <div>
                    <div class="label">Employee pay summary</div>
                    <div class="value" id="lbEmployeeName">No employee selected</div>
                    <div class="sub" id="lbEmployeeID">Select a row or fill in the form</div>
                </div>
                <div><div class="label">Gross pay</div><div class="value" id="lbGrossPay">₱0.00</div></div>
                <div><div class="label">Deductions</div><div class="value" id="lbTotalDeductions">₱0.00</div></div>
                <div><div class="label">Net pay</div><div class="value big" id="lbNetPay">₱0.00</div></div>
                <div class="hero-action"><button type="button" class="btn btn-outline" id="btnPrintEmpPaySum">Print pay summary</button></div>
            </div>

            <div class="layout">
                <form id="payroll-form" class="stack" method="post" action="/payroll" novalidate>
                    <input type="hidden" name="_token" value="{{csrfToken}}">

                    <div class="card">
                        <div class="card-head"><h2>Payroll period</h2></div>
                        <div class="card-body fields">
                            <div class="field"><label for="dtStartPeriod">Start date</label><input class="input" type="date" id="dtStartPeriod" name="pay_start" value="{{payroll.start}}"></div>
                            <div class="field"><label for="dtEndPeriod">End date</label><input class="input" type="date" id="dtEndPeriod" name="pay_end" value="{{payroll.end}}"></div>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-head"><h2>Employee details</h2><span class="badge new" id="payMode">New entry</span></div>
                        <div class="card-body">
                            <div class="fields">
                                <div class="field full"><label for="txtEmployeeName">Name</label><input class="input" id="txtEmployeeName" name="name" placeholder="Full name"></div>
                                <div class="field"><label for="txtEmployeeID">Employee ID</label><input class="input" id="txtEmployeeID" name="employee_id" placeholder="F-007"></div>
                                <div class="field"><label for="udDaysWorked">Days worked</label>
                                    <div class="stepper"><button type="button" tabindex="-1" data-step="-1" aria-label="Decrease">−</button><input id="udDaysWorked" name="days_worked" value="0" inputmode="numeric" data-min="0" data-max="100"><button type="button" tabindex="-1" data-step="1" aria-label="Increase">+</button></div></div>
                                <div class="field"><label for="udOTHours">OT hours</label>
                                    <div class="stepper"><button type="button" tabindex="-1" data-step="-1" aria-label="Decrease">−</button><input id="udOTHours" name="ot_hours" value="0" inputmode="numeric" data-min="0" data-max="100"><button type="button" tabindex="-1" data-step="1" aria-label="Increase">+</button></div></div>
                                <div class="field"><label for="udLate">Late hours</label>
                                    <div class="stepper"><button type="button" tabindex="-1" data-step="-1" aria-label="Decrease">−</button><input id="udLate" name="late_hours" value="0" inputmode="numeric" data-min="0" data-max="100"><button type="button" tabindex="-1" data-step="1" aria-label="Increase">+</button></div></div>
                                <div class="field"><label for="udHolidaysWork">Holidays worked</label>
                                    <div class="stepper"><button type="button" tabindex="-1" data-step="-1" aria-label="Decrease">−</button><input id="udHolidaysWork" name="holiday_present" value="0" inputmode="numeric" data-min="0" data-max="100"><button type="button" tabindex="-1" data-step="1" aria-label="Increase">+</button></div></div>
                                <div class="field"><label for="cmbHolidayType">Holiday type</label>
                                    <select class="select" id="cmbHolidayType" name="holiday_type">
                                        <option value="">None</option>
                                        {{#payroll.holidayTypes}}<option value="{{value}}">{{value}}</option>{{/payroll.holidayTypes}}
                                    </select></div>
                            </div>

                            <div class="section-title" style="margin-top:22px;">Deductions</div>
                            <div class="fields">
                                <div class="field full"><label for="txtDeductionPerHour">Deduction per late hour (₱)</label><input class="input" id="txtDeductionPerHour" name="deduction_per_hour" inputmode="decimal" placeholder="0.00"></div>
                                <div class="field"><label for="txtSSS">SSS</label><input class="input" id="txtSSS" name="sss" inputmode="decimal" placeholder="0.00"></div>
                                <div class="field"><label for="txtPhilhealth">PhilHealth</label><input class="input" id="txtPhilhealth" name="philhealth" inputmode="decimal" placeholder="0.00"></div>
                                <div class="field"><label for="txtPagibig">Pag-IBIG</label><input class="input" id="txtPagibig" name="pagibig" inputmode="decimal" placeholder="0.00"></div>
                                <div class="field"><label for="txtOthers">Others</label><input class="input" id="txtOthers" name="others" inputmode="decimal" placeholder="0.00"></div>
                            </div>
                        </div>
                        <div class="card-foot">
                            <button type="submit" class="btn btn-primary btn-block" id="btnAddCalculate" {{#isEmployee}}disabled title="Not available for employee accounts"{{/isEmployee}}>Add &amp; calculate</button>
                            <div class="btn-row" style="width:100%">
                                <button type="button" class="btn btn-outline" id="btnEditPayroll">Edit</button>
                                <button type="button" class="btn btn-outline" id="btnUpdatePayroll">Update</button>
                                <button type="button" class="btn btn-ghost" id="btnClearPayroll">Clear</button>
                            </div>
                        </div>
                    </div>
                </form>

                <div class="stack">
                    <div class="stats" style="grid-template-columns:repeat(3,minmax(0,1fr));margin:0;">
                        <div class="stat"><div class="stat-label">Employees</div><div class="stat-value">{{payroll.count}}</div></div>
                        <div class="stat"><div class="stat-label">Total gross</div><div class="stat-value">{{payroll.totalGross}}</div></div>
                        <div class="stat"><div class="stat-label">Total net pay</div><div class="stat-value">{{payroll.totalNet}}</div><div class="stat-note">after {{payroll.totalDed}} deductions</div></div>
                    </div>

                    <div class="card">
                        <div class="card-head"><h2>Payroll records</h2><span class="hint">Click a row to view</span></div>
                        <div class="table-wrap dgv" id="payrollGrid">
                            <table>
                                <thead><tr><th>Employee</th><th class="num">Days</th><th class="num">OT</th><th class="num">Late</th><th>Holiday</th><th class="num">Gross</th><th class="num">Deductions</th><th class="num">Net pay</th></tr></thead>
                                <tbody>
                                    {{#payroll.rows}}
                                    <tr data-id="{{id}}" data-employee-id="{{employee_id}}" data-row="{{json}}">
                                        <td><div class="person"><span class="avatar">{{initials}}</span><div><div class="strong">{{name}}</div><div class="meta">{{employee_id}}</div></div></div></td>
                                        <td class="num">{{days_worked}}</td>
                                        <td class="num">{{ot_hours}}</td>
                                        <td class="num">{{late_hours}}</td>
                                        <td>{{#holiday_type}}<span class="badge">{{holiday_present}} · {{holiday_type}}</span>{{/holiday_type}}{{^holiday_type}}<span class="muted">—</span>{{/holiday_type}}</td>
                                        <td class="num">{{gross_display}}</td>
                                        <td class="num muted">{{ded_display}}</td>
                                        <td class="num strong">{{net_display}}</td>
                                    </tr>
                                    {{/payroll.rows}}
                                    {{^payroll.rows}}
                                    <tr class="empty-row"><td colspan="8">No payroll records yet.</td></tr>
                                    {{/payroll.rows}}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>
    </div>
</div>

<form id="logout-form" method="post" action="/logout" hidden><input type="hidden" name="_token" value="{{csrfToken}}"></form>
<div id="old-input" hidden data-json="{{oldJson}}"></div>
<div id="page-state" hidden data-inventory-selected="{{inventory.selected}}" data-payroll-selected="{{payroll.selected}}"></div>
