{{!
    C# Form2 "But First, System" - ClientSize 1238 x 778, BackColor LightGray.
    Every left/top/width/height below is copied from Form2.Designer.cs.
    Positions inside a tab page are relative to the tab page; inside a panel, to the panel.
    A status strip (22px) is added at the bottom to show the external holiday API result.
}}
<div class="win" id="main-window" style="width:1238px;" data-window-kind="main" data-role="{{user.role}}">
    {{> titlebar}}
    <div class="client" style="width:1238px;height:800px;background:#D3D3D3;">

        <!-- panel1 (black header) -->
        <div class="wf-box" style="left:-3px;top:-5px;width:1234px;height:56px;background:#000;">
            <img src="/assets/img/logo.png" alt="" class="wf-abs" style="left:24px;top:6px;width:47px;height:53px;object-fit:none;object-position:left top;">
            <span class="wf-label" style="left:67px;top:18px;color:#fff;font:800 15.75pt Figtree,sans-serif;">BUT FIRST, SYSTEM</span>
        </div>

        <!-- tabControl1 (Appearance = FlatButtons) -->
        <div class="wf-tabs" style="left:8px;top:57px;width:1223px;height:708px;">
            <div class="wf-tabstrip" role="tablist">
                <a href="/inventory" role="tab" class="wf-tab{{#tabInventory}} selected{{/tabInventory}}" data-tab="inventory">INVENTORY</a>
                <a href="/schedule" role="tab" class="wf-tab{{#tabSchedule}} selected{{/tabSchedule}}" data-tab="schedule">EMPLOYEE SCHEDULE</a>
                <a href="/payroll" role="tab" class="wf-tab{{#tabPayroll}} selected{{/tabPayroll}}" data-tab="payroll">PAYROLL MANAGEMENT</a>
            </div>

            <!-- =========================================================== -->
            <!-- tabPage1  INVENTORY                                          -->
            <!-- =========================================================== -->
            <section class="wf-tabpage" id="tab-inventory" data-tabpage="inventory" {{^tabInventory}}hidden{{/tabInventory}}>

                <span class="wf-label" style="left:11px;top:16px;font:400 20.25pt 'Microsoft Sans Serif',Tahoma,sans-serif;">&#x2315;</span>
                <form id="search-form" method="get" action="/inventory" class="wf-contents">
                    <input class="wf-text" id="txtSearch" name="search" value="{{inventory.search}}" placeholder="Search for products in the list" autocomplete="off" style="left:44px;top:19px;width:1056px;height:25px;">
                </form>
                <button type="button" class="wf-btn flat" id="btnClear_Inv" style="left:1106px;top:19px;width:103px;height:25px;font:800 9.75pt Figtree,sans-serif;">Clear</button>

                <!-- panel2  Product Information -->
                <form id="product-form" method="post" action="/inventory" enctype="multipart/form-data" class="wf-panel" style="left:9px;top:57px;width:300px;height:339px;" novalidate>
                    <input type="hidden" name="_token" value="{{csrfToken}}">
                    <input type="hidden" name="image_path" id="hidImagePath" value="">
                    <input type="file" name="image" id="fileImage" accept=".jpg,.jpeg,.png,.bmp,image/jpeg,image/png,image/bmp" hidden>

                    <span class="wf-label" style="left:60px;top:13px;background:#fff;font:700 14.25pt Figtree,sans-serif;">Product Information</span>

                    <label class="wf-label" for="txtProductName" style="left:15px;top:45px;">Product Name:</label>
                    <input class="wf-text" id="txtProductName" name="product_name" style="left:18px;top:66px;width:268px;height:25px;">

                    <label class="wf-label" for="cmbCategory" style="left:15px;top:97px;">Category:</label>
                    <select class="wf-combo" id="cmbCategory" name="category" style="left:18px;top:119px;width:143px;height:26px;">
                        <option value=""></option>
                        {{#inventory.categories}}<option value="{{value}}">{{value}}</option>{{/inventory.categories}}
                    </select>

                    <label class="wf-label" for="udQuantity" style="left:176px;top:97px;">Quantity:</label>
                    <div class="wf-num" style="left:167px;top:120px;width:119px;height:25px;">
                        <input id="udQuantity" name="quantity" value="0" inputmode="numeric" data-min="0" data-max="1000">
                        <span class="wf-spin"><button type="button" tabindex="-1" data-step="1"></button><button type="button" tabindex="-1" data-step="-1"></button></span>
                    </div>

                    <label class="wf-label" for="txtPrice" style="left:15px;top:150px;">Price:</label>
                    <input class="wf-text" id="txtPrice" name="price" inputmode="decimal" style="left:18px;top:172px;width:143px;height:25px;">

                    <label class="wf-label" for="dtDateAdded" style="left:175px;top:150px;">Date Added:</label>
                    <input class="wf-date" type="date" id="dtDateAdded" name="date_added" value="{{today}}" style="left:167px;top:172px;width:120px;height:25px;">

                    <label class="wf-label" for="txtSupplier" style="left:15px;top:202px;">Supplier:</label>
                    <input class="wf-text" id="txtSupplier" name="supplier" style="left:18px;top:223px;width:143px;height:25px;">

                    <label class="wf-label" for="txtProductID" style="left:175px;top:202px;">ID:</label>
                    <input class="wf-text" id="txtProductID" readonly tabindex="-1" style="left:167px;top:223px;width:120px;height:25px;">

                    <button type="button" class="wf-btn flat" id="btnLoad" style="left:18px;top:261px;width:54px;height:29px;">Load</button>
                    <button type="button" class="wf-btn popup-white" id="btnUpdate" style="left:78px;top:261px;width:48px;height:29px;" {{#isEmployee}}disabled{{/isEmployee}}>Edit</button>
                    <button type="submit" class="wf-btn flat" id="btnAdd" style="left:130px;top:261px;width:69px;height:29px;">Add</button>
                    <button type="button" class="wf-btn popup-white" id="btnRemove" style="left:203px;top:261px;width:73px;height:29px;" {{#isEmployee}}disabled{{/isEmployee}}>Remove</button>
                    <button type="button" class="wf-btn flat" id="btnPrintInventorySum" style="left:18px;top:296px;width:259px;height:33px;">Print Summary</button>
                </form>
                <form id="remove-form" method="post" action="" hidden>
                    <input type="hidden" name="_token" value="{{csrfToken}}">
                </form>

                <!-- inventoryGrid -->
                <div class="dgv" id="inventoryGrid" data-select="cell" style="left:314px;top:57px;width:895px;height:338px;background:#fff;">
                    <table>
                        <colgroup><col style="width:51px"><col span="8" style="width:100px"></colgroup>
                        <thead>
                            <tr><th class="rh"></th><th>Product ID</th><th>Product Name</th><th>Category</th><th>Price</th><th>Quantity</th><th>Supplier</th><th>Date Added</th><th>ImagePath</th></tr>
                        </thead>
                        <tbody>
                            {{#inventory.rows}}
                            <tr data-id="{{product_id}}" data-row="{{json}}">
                                <th class="rh"></th>
                                <td>{{product_id}}</td><td>{{product_name}}</td><td>{{category}}</td><td>{{price_display}}</td>
                                <td>{{quantity}}</td><td>{{supplier}}</td><td>{{date_display}}</td><td>{{image_path}}</td>
                            </tr>
                            {{/inventory.rows}}
                            <tr class="newrow"><th class="rh">*</th><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr>
                        </tbody>
                    </table>
                </div>

                <!-- panel3  Image -->
                <div class="wf-panel" style="left:9px;top:402px;width:300px;height:259px;">
                    <span class="wf-label" style="left:122px;top:7px;background:#fff;font:800 11.25pt Figtree,sans-serif;">Image:</span>
                    <div class="wf-picture" id="pboxProductImage" style="left:19px;top:31px;width:259px;height:178px;background:#DCDCDC;"><img alt="" hidden></div>
                    <button type="button" class="wf-btn flat" id="btnBrowse" style="left:19px;top:215px;width:259px;height:33px;">Browse Image</button>
                </div>

                <!-- panel4  Image File Path -->
                <div class="wf-panel" style="left:315px;top:402px;width:367px;height:82px;">
                    <span class="wf-label" style="left:15px;top:17px;background:#fff;font:800 11.25pt Figtree,sans-serif;">Image File Path:</span>
                    <input class="wf-text" id="txtFilePath" readonly style="left:15px;top:42px;width:331px;height:25px;">
                </div>

                <!-- panel5  Summary -->
                <div class="wf-panel" style="left:315px;top:490px;width:367px;height:171px;">
                    <span class="wf-label" style="left:134px;top:17px;background:#fff;font:700 14.25pt Figtree,sans-serif;">Summary:</span>
                    <span class="wf-label" id="lbMostStocked" style="left:10px;top:58px;">{{inventory.summary.most}}</span>
                    <span class="wf-label" id="lbLeastStocked" style="left:10px;top:90px;">{{inventory.summary.least}}</span>
                    <span class="wf-label" id="lbTotal" style="left:10px;top:123px;">{{inventory.summary.total}}</span>
                </div>

                <!-- chart1 -->
                <div class="wf-chart" style="left:689px;top:402px;width:520px;height:259px;">{{{inventory.chart}}}</div>
            </section>

            <!-- =========================================================== -->
            <!-- tabPage2  EMPLOYEE SCHEDULE                                  -->
            <!-- =========================================================== -->
            <section class="wf-tabpage" id="tab-schedule" data-tabpage="schedule" {{^tabSchedule}}hidden{{/tabSchedule}}>

                <span class="wf-label" style="left:424px;top:19px;font:800 24pt Figtree,sans-serif;">Employee Shift Generator</span>

                <!-- panel6  Shift Schedule Period -->
                <div class="wf-panel" style="left:18px;top:75px;width:343px;height:162px;">
                    <span class="wf-label" style="left:70px;top:16px;background:#fff;font:800 14.25pt Figtree,sans-serif;">Shift Schedule Period:</span>
                    <label class="wf-label" for="dtStartDate" style="left:38px;top:57px;font-size:12pt;">Start Date:</label>
                    <input class="wf-date" type="date" id="dtStartDate" value="{{schedule.start}}" style="left:126px;top:55px;width:173px;height:27px;font-size:12pt;">
                    <label class="wf-label" for="dtEndDate" style="left:40px;top:102px;font-size:12pt;">End Date:</label>
                    <input class="wf-date" type="date" id="dtEndDate" value="{{schedule.end}}" style="left:126px;top:100px;width:173px;height:27px;font-size:12pt;">
                </div>

                <!-- panel7  Employee Details -->
                <div class="wf-panel" style="left:18px;top:256px;width:343px;height:335px;">
                    <span class="wf-label" style="left:87px;top:17px;background:#fff;font:800 14.25pt Figtree,sans-serif;">Employee Details:</span>
                    <label class="wf-label" for="txtEmployee" style="left:17px;top:44px;">Name:</label>
                    <input class="wf-text" id="txtEmployee" readonly style="left:20px;top:65px;width:296px;height:25px;">
                    <label class="wf-label" for="txtSchedule" style="left:17px;top:104px;">Schedule:</label>
                    <input class="wf-text" id="txtSchedule" readonly style="left:20px;top:125px;width:296px;height:25px;">
                    <label class="wf-label" for="txtBreak" style="left:17px;top:164px;">Break:</label>
                    <input class="wf-text" id="txtBreak" readonly style="left:20px;top:185px;width:296px;height:25px;">
                    <label class="wf-label" for="txtDuties" style="left:17px;top:220px;">Duties:</label>
                    <textarea class="wf-text" id="txtDuties" readonly style="left:20px;top:241px;width:296px;height:60px;"></textarea>
                </div>

                <!-- shiftGrid (Fill columns, FullRowSelect) -->
                <div class="dgv fill" id="shiftGrid" data-select="row" style="left:378px;top:75px;width:817px;height:351px;background:#F5F5F5;">
                    <table>
                        <colgroup><col style="width:41px"><col><col><col><col><col></colgroup>
                        <thead>
                            <tr style="height:30px"><th class="rh"></th><th>Employee Names</th><th>Schedule</th><th>Breaks</th><th>Duties</th><th>Day Off</th></tr>
                        </thead>
                        <tbody>
                            {{#schedule.rows}}
                            <tr data-id="{{id}}" data-row="{{json}}">
                                <th class="rh"></th><td>{{names}}</td><td>{{schedule}}</td><td>{{breaks}}</td><td>{{duties}}</td><td>{{day_off}}</td>
                            </tr>
                            {{/schedule.rows}}
                            <tr class="newrow"><th class="rh">*</th><td></td><td></td><td></td><td></td><td></td></tr>
                        </tbody>
                    </table>
                </div>

                <!-- panel8  Day off request -->
                <form id="dayoff-form" method="post" action="/schedule/dayoff" class="wf-panel" style="left:378px;top:445px;width:425px;height:146px;">
                    <input type="hidden" name="_token" value="{{csrfToken}}">
                    <input type="hidden" name="names" id="hidDayoffName">
                    <input type="hidden" name="sched_start" class="js-sched-start">
                    <input type="hidden" name="sched_end" class="js-sched-end">
                    <span class="wf-label" style="left:79px;top:27px;background:#fff;font:800 18pt Figtree,sans-serif;">Please Select Day off:</span>
                    <select class="wf-combo system" id="cmbDayoff" name="day_off" style="left:29px;top:72px;width:241px;height:40px;font-size:20.25pt;">
                        <option value=""></option>
                        {{#schedule.days}}<option value="{{value}}">{{value}}</option>{{/schedule.days}}
                    </select>
                    <button type="submit" class="wf-btn popup-black" id="btnRequest" style="left:283px;top:72px;width:112px;height:40px;font:800 15.75pt Figtree,sans-serif;">Request</button>
                </form>

                <form id="randomize-form" method="post" action="/schedule/randomize" class="wf-contents">
                    <input type="hidden" name="_token" value="{{csrfToken}}">
                    <input type="hidden" name="sched_start" class="js-sched-start">
                    <input type="hidden" name="sched_end" class="js-sched-end">
                    <button type="submit" class="wf-btn popup-black" id="btnRandomize" style="left:824px;top:445px;width:371px;height:68px;font:800 18pt Figtree,sans-serif;">Randomize Shift Schedule</button>
                </form>
                <button type="button" class="wf-btn popup-black" id="btnPrintSched" style="left:824px;top:530px;width:187px;height:61px;font:800 18pt Figtree,sans-serif;">Print Schedule</button>
                <form id="reset-dayoff-form" method="post" action="/schedule/reset-dayoff" class="wf-contents">
                    <input type="hidden" name="_token" value="{{csrfToken}}">
                    <input type="hidden" name="sched_start" class="js-sched-start">
                    <input type="hidden" name="sched_end" class="js-sched-end">
                    <button type="button" class="wf-btn popup-black" id="btnResetDayoff" style="left:1026px;top:530px;width:169px;height:61px;font:800 18pt Figtree,sans-serif;">Reset Dayoff</button>
                </form>
            </section>

            <!-- =========================================================== -->
            <!-- tabPage3  PAYROLL MANAGEMENT                                 -->
            <!-- =========================================================== -->
            <section class="wf-tabpage" id="tab-payroll" data-tabpage="payroll" {{^tabPayroll}}hidden{{/tabPayroll}}>
                <form id="payroll-form" method="post" action="/payroll" class="wf-contents" novalidate>
                <input type="hidden" name="_token" value="{{csrfToken}}">

                <span class="wf-label" style="left:487px;top:11px;font:800 24pt Figtree,sans-serif;">Payroll Management</span>

                <!-- panel9  Payroll Period -->
                <div class="wf-panel" style="left:9px;top:62px;width:267px;height:110px;">
                    <span class="wf-label" style="left:64px;top:8px;background:#fff;font:800 14.25pt Figtree,sans-serif;">Payroll Period:</span>
                    <label class="wf-label" for="dtStartPeriod" style="left:23px;top:39px;">Start Date:</label>
                    <input class="wf-date" type="date" id="dtStartPeriod" name="pay_start" value="{{payroll.start}}" style="left:111px;top:37px;width:117px;height:25px;">
                    <label class="wf-label" for="dtEndPeriod" style="left:25px;top:72px;">End Date:</label>
                    <input class="wf-date" type="date" id="dtEndPeriod" name="pay_end" value="{{payroll.end}}" style="left:111px;top:70px;width:117px;height:25px;">
                </div>

                <!-- panel10  Employee Details -->
                <div class="wf-panel" style="left:9px;top:178px;width:267px;height:425px;">
                    <span class="wf-label" style="left:51px;top:8px;background:#fff;font:800 14.25pt Figtree,sans-serif;">Employee Details</span>
                    <label class="wf-label" for="txtEmployeeName" style="left:15px;top:35px;">Name:</label>
                    <input class="wf-text pay-field" id="txtEmployeeName" name="name" style="left:18px;top:56px;width:225px;height:25px;">
                    <label class="wf-label" for="txtEmployeeID" style="left:15px;top:87px;">Employee ID:</label>
                    <input class="wf-text pay-field" id="txtEmployeeID" name="employee_id" style="left:18px;top:108px;width:107px;height:25px;">
                    <label class="wf-label" for="udLate" style="left:133px;top:86px;">Late Hours:</label>
                    <div class="wf-num" style="left:136px;top:109px;width:107px;height:25px;">
                        <input class="pay-field" id="udLate" name="late_hours" value="0" inputmode="numeric" data-min="0" data-max="100">
                        <span class="wf-spin"><button type="button" tabindex="-1" data-step="1"></button><button type="button" tabindex="-1" data-step="-1"></button></span>
                    </div>
                    <label class="wf-label" for="udDaysWorked" style="left:15px;top:140px;">Days Worked:</label>
                    <div class="wf-num" style="left:18px;top:163px;width:107px;height:25px;">
                        <input class="pay-field" id="udDaysWorked" name="days_worked" value="0" inputmode="numeric" data-min="0" data-max="100">
                        <span class="wf-spin"><button type="button" tabindex="-1" data-step="1"></button><button type="button" tabindex="-1" data-step="-1"></button></span>
                    </div>
                    <label class="wf-label" for="udOTHours" style="left:133px;top:140px;">OT Hours:</label>
                    <div class="wf-num" style="left:136px;top:163px;width:107px;height:25px;">
                        <input class="pay-field" id="udOTHours" name="ot_hours" value="0" inputmode="numeric" data-min="0" data-max="100">
                        <span class="wf-spin"><button type="button" tabindex="-1" data-step="1"></button><button type="button" tabindex="-1" data-step="-1"></button></span>
                    </div>
                    <label class="wf-label" for="udHolidaysWork" style="left:15px;top:203px;font-size:9.75pt;">Holidays Worked:</label>
                    <div class="wf-num" style="left:18px;top:225px;width:107px;height:25px;">
                        <input class="pay-field" id="udHolidaysWork" name="holiday_present" value="0" inputmode="numeric" data-min="0" data-max="100">
                        <span class="wf-spin"><button type="button" tabindex="-1" data-step="1"></button><button type="button" tabindex="-1" data-step="-1"></button></span>
                    </div>
                    <label class="wf-label" for="cmbHolidayType" style="left:133px;top:202px;">Holiday Type:</label>
                    <select class="wf-combo pay-field" id="cmbHolidayType" name="holiday_type" style="left:136px;top:225px;width:107px;height:26px;">
                        <option value=""></option>
                        {{#payroll.holidayTypes}}<option value="{{value}}">{{value}}</option>{{/payroll.holidayTypes}}
                    </select>

                    <button type="submit" class="wf-btn flat" id="btnAddCalculate" style="left:18px;top:260px;width:225px;height:33px;font:800 12pt Figtree,sans-serif;" {{#isEmployee}}disabled{{/isEmployee}}>Add | Calculate</button>
                    <button type="button" class="wf-btn flat" id="btnEditPayroll" style="left:18px;top:299px;width:225px;height:33px;font:800 12pt Figtree,sans-serif;">Edit</button>
                    <button type="button" class="wf-btn flat" id="btnUpdatePayroll" style="left:18px;top:338px;width:225px;height:33px;font:800 12pt Figtree,sans-serif;">Update</button>
                    <button type="button" class="wf-btn flat" id="btnClearPayroll" style="left:18px;top:377px;width:225px;height:33px;font:800 12pt Figtree,sans-serif;">Clear</button>
                </div>

                <!-- payrollGrid -->
                <div class="dgv" id="payrollGrid" data-select="cell" style="left:282px;top:62px;width:927px;height:388px;background:#fff;">
                    <table>
                        <colgroup><col style="width:51px"><col span="15" style="width:100px"></colgroup>
                        <thead>
                            <tr style="height:50px"><th class="rh"></th><th>Name</th><th>Employee ID</th><th>Days Worked</th><th>OT Hours</th><th>Late Hours</th><th>Deduction/Hour</th><th>Holiday Present</th><th>Holiday Type</th><th>Net Pay</th><th>Gross Pay</th><th>Total Deductions</th><th>SSS</th><th>PhilHealth</th><th>Pagibig</th><th>Others</th></tr>
                        </thead>
                        <tbody>
                            {{#payroll.rows}}
                            <tr data-id="{{id}}" data-employee-id="{{employee_id}}" data-row="{{json}}">
                                <th class="rh"></th>
                                <td>{{name}}</td><td>{{employee_id}}</td><td>{{days_worked}}</td><td>{{ot_hours}}</td><td>{{late_hours}}</td>
                                <td>{{deduction_per_hour}}</td><td>{{holiday_present}}</td><td>{{holiday_type}}</td><td>{{net_pay}}</td>
                                <td>{{gross_pay}}</td><td>{{total_deductions}}</td><td>{{sss}}</td><td>{{philhealth}}</td><td>{{pagibig}}</td><td>{{others}}</td>
                            </tr>
                            {{/payroll.rows}}
                            <tr class="newrow"><th class="rh">*</th><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr>
                        </tbody>
                    </table>
                </div>

                <!-- panel11  Deductions -->
                <div class="wf-panel" style="left:282px;top:455px;width:394px;height:207px;">
                    <span class="wf-label" style="left:144px;top:10px;background:#fff;font:800 14.25pt Figtree,sans-serif;">Deductions</span>
                    <label class="wf-label" for="txtDeductionPerHour" style="left:16px;top:37px;">Deduction per Hour (Late)</label>
                    <input class="wf-text pay-field" id="txtDeductionPerHour" name="deduction_per_hour" inputmode="decimal" style="left:19px;top:58px;width:352px;height:25px;">
                    <label class="wf-label" for="txtPhilhealth" style="left:16px;top:91px;">PhilHealth:</label>
                    <input class="wf-text pay-field" id="txtPhilhealth" name="philhealth" inputmode="decimal" style="left:19px;top:112px;width:153px;height:25px;">
                    <label class="wf-label" for="txtPagibig" style="left:215px;top:91px;">Pag-IBIG:</label>
                    <input class="wf-text pay-field" id="txtPagibig" name="pagibig" inputmode="decimal" style="left:218px;top:112px;width:153px;height:25px;">
                    <label class="wf-label" for="txtSSS" style="left:16px;top:146px;">SSS:</label>
                    <input class="wf-text pay-field" id="txtSSS" name="sss" inputmode="decimal" style="left:19px;top:167px;width:153px;height:25px;">
                    <label class="wf-label" for="txtOthers" style="left:215px;top:146px;">Others:</label>
                    <input class="wf-text pay-field" id="txtOthers" name="others" inputmode="decimal" style="left:218px;top:167px;width:153px;height:25px;">
                </div>

                <!-- panel12  Employee Pay Summary -->
                <div class="wf-panel" style="left:682px;top:456px;width:527px;height:206px;">
                    <span class="wf-label" style="left:149px;top:21px;background:#fff;font:800 14.25pt Figtree,sans-serif;">Employee Pay Summary:</span>
                    <span class="wf-label" id="lbEmployeeName" style="left:30px;top:60px;">Name:</span>
                    <span class="wf-label" id="lbGrossPay" style="left:313px;top:60px;">Gross Pay:</span>
                    <span class="wf-label" id="lbEmployeeID" style="left:30px;top:99px;">Employee ID:</span>
                    <span class="wf-label" id="lbNetPay" style="left:313px;top:99px;">Net Pay:</span>
                    <button type="button" class="wf-btn flat" id="btnPrintEmpPaySum" style="left:33px;top:137px;width:457px;height:46px;font:800 15.75pt Figtree,sans-serif;">Print Employee Pay Summary</button>
                </div>

                <button type="button" class="wf-btn flat" id="btnPrintPayroll" style="left:9px;top:609px;width:267px;height:53px;font:800 18pt Figtree,sans-serif;">Print Payroll</button>
                </form>
            </section>
