{
    "name": "butfirst/system-php",
    "description": "BUT FIRST, SYSTEM - Inventory, Employee Schedule and Payroll management on a DIY PHP framework (bramus/router + mustache + Eloquent).",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-curl": "*",
        "bramus/router": "^1.6",
        "mustache/mustache": "^2.14",
        "illuminate/database": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "php -S localhost:8000 -t public public/index.php"
        ],
        "db:seed": "php database/seed.php",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    }
}
